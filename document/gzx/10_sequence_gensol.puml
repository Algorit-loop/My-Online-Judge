@startuml Sequence_GenSol
!theme plain
skinparam sequenceMessageAlign center
skinparam maxMessageSize 200
skinparam participant {
  BackgroundColor #E8F5E9
}

title Sequence Diagram: Generate Testcase - GensolJob (BKDNOJ moi)

actor "Admin\n(Problem Setter)" as A
participant "Django Site\n(GensolStartView)" as Site
participant "gensol utils\n(utils/gensol.py)" as Util
database "MariaDB" as DB
participant "Bridge\n:9998" as Bridge
participant "Judge Server\n:9999" as Judge
participant "WSEvent" as WS

== 1. Admin nhap Generator va Solution ==
A -> Site : GET /problem/<code>/test_data/generate
Site --> A : Form: generator source, solution source,\nchon ngon ngu, so test case (1..50)

A -> Site : POST gensol/start\n{generator_source, solution_source,\ngenerator_lang, solution_lang, num_cases}

== 2. Tao GensolJob + STAGE GENERATOR ==
Site -> DB : INSERT GensolJob (status='PENDING')
Site -> Util : start_gensol_job(job)
Util -> DB : DELETE ProblemTestCase cu
Util -> Util : Tao "virtual zip":\nmoi input = so thu tu (1..N), output rong
Util -> DB : Upload zip -> ProblemData + init.yml
Util -> DB : UPDATE status='GENERATING_INPUT'\ncurrent_step='generator'
Util -> Bridge : judge_request\n**gensol-request** {gensol-step='generator'}
Site --> A : JSON {job_id, id_secret}
A -> WS : Subscribe channel **gensol_<id_secret>**

Bridge -> Judge : TCP :9999 gensol_submit\n(submission-request, sample-testcase-only)

loop Moi test case (1..N)
  Judge -> Judge : Chay generator (stdin = so thu tu)\n-> sinh input data
  Judge --> Bridge : test-case-status {position, output}
  Bridge -> Util : save_testcase_output('generator', n, output)
  Util -> Util : Luu working_dir/inputs/<n>.txt
  Bridge -> WS : POST event {testcase: n}
  WS -> A : WebSocket {progress}
end

== 3. grading-end: chuyen sang STAGE SOLUTION ==
Judge --> Bridge : grading-end
Bridge -> Util : on_gensol_grading_end(job, 'generator')
Util -> Util : _transition_to_solution:\nbuild zip tu inputs (output rong)
Util -> DB : Upload zip -> ProblemData + init.yml
Util -> DB : UPDATE status='GENERATING_OUTPUT'\ncurrent_step='solution'
Util -> Bridge : judge_request\n**gensol-request** {gensol-step='solution'}

Bridge -> Judge : TCP :9999 gensol_submit

loop Moi test case (1..N)
  Judge -> Judge : Chay solution (stdin = input da sinh)\n-> sinh expected output
  Judge --> Bridge : test-case-status {position, output}
  Bridge -> Util : save_testcase_output('solution', n, output)
  Util -> Util : Luu working_dir/outputs/<n>.txt
end

== 4. grading-end: finalize + upload ==
Judge --> Bridge : grading-end
Bridge -> Util : on_gensol_grading_end(job, 'solution')
Util -> Util : _finalize_job: build zip cuoi (inputs + outputs)
Util -> Util : Kiem tra size <= GENSOL_MAX_ZIP_SIZE (64MB)
Util -> DB : Upload zip -> ProblemData + init.yml\n+ tao ProblemTestCase[]
Util -> DB : UPDATE status='DONE'
Util -> Util : Cleanup working_dir
Util -> WS : POST event {type: done}
WS -> A : WebSocket {Generate thanh cong! N test cases}

note over Bridge, Util
  Toan bo dieu phoi (generator -> solution -> finalize)
  chay TRONG tien trinh Bridge bang cach goi
  judge/utils/gensol.py - **KHONG dung Redis signal**.
  Loi test case: on_gensol_error -> status='ERROR'.
end note

@enduml
