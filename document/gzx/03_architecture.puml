@startuml Architecture_ALOJ
!theme plain
skinparam component {
  BackgroundColor<<new>> #DDFFD6
  BorderColor<<new>> #2E8B57
  BackgroundColor<<external>> #FFF3CD
  BorderColor<<external>> #856404
}
skinparam node {
  BackgroundColor #F0F8FF
}
skinparam cloud {
  BackgroundColor #FFF0F0
}

title Kien truc tong the he thong ALOJ - Algorit Online Judge

cloud "Internet" as Internet {
  actor "Browser\n(User)" as Browser
}

cloud "AI Providers" <<external>> as AI {
  component "OpenAI API" as OpenAI <<external>>
  component "Google Gemini API" as Gemini <<external>>
  component "Anthropic Claude API" as Claude <<external>>
  component "DeepSeek API" as DeepSeek <<external>>
}

node "Docker Host" as DockerHost {

  frame "Network: nginx" as NetNginx {
    component "**Nginx**\naloj_nginx\n:80 (HTTP)" as Nginx
  }

  frame "Network: site + nginx" {
    component "**Django Site**\naloj_site\nuWSGI :8000\n(8 workers)" as Site
    component "**WSEvent**\naloj_wsevent\nNode.js\n:15100 (WS)\n:15101 (POST)\n:15102 (Poll)" as WSEvent
  }

  frame "Network: site" {
    component "**Redis**\naloj_redis\n:6379\nCache + Broker" as Redis
    component "**Celery**\naloj_celery\n(2 workers)" as Celery
  }

  frame "Network: db" {
    database "**MariaDB**\naloj_mysql\n:3306\nUTF8MB4 / InnoDB" as DB
  }

  frame "Network: site + nginx + db" {
    component "**Bridge Daemon**\naloj_bridged\n:9998 (Site<->Bridge)\n:9999 (Bridge<->Judge)" as Bridge
  }
}

node "Judge Server(s)" <<external>> as JudgeNode {
  component "**Judge**\nvnoj/judge-tiervnoj\nSandbox Execution\n30+ Languages" as Judge <<external>>
}

' === Connections ===

' Browser -> Nginx
Browser -down-> Nginx : "HTTP :80"

' Nginx routing
Nginx -down-> Site : "/ -> uWSGI :8000"
Nginx -down-> WSEvent : "/event/ -> WS :15100\n/channels/ -> :15102"
Nginx -right-> Nginx : "/static/ /media/\n(local files)"

' Site connections
Site -down-> DB : "SQL (ORM)"
Site -down-> Redis : "Cache / Session"
Site -right-> Bridge : "TCP :9998\n(submission-request\nrun-request\ngensol-request)"
Site -left-> AI : "HTTPS\n(AI Code Review\nAI Problem Creator\nAI Gen Code)"

' Celery
Celery -down-> DB : "SQL"
Celery -left-> Redis : "Broker (DB1)"
Celery -right-> Bridge : "TCP :9998\n(gensol-request)"

' Bridge
Bridge -down-> Judge : "TCP :9999\n(JSON + Zlib\n4-byte header)"
Bridge -up-> WSEvent : "POST :15101\n(event broadcast)"
Bridge -left-> DB : "SQL\n(save results)"

' WSEvent -> Browser
WSEvent -up-> Browser : "WebSocket\n(realtime updates)"

' Redis shared
WSEvent -down-> Redis : "Pub/Sub"

@enduml
