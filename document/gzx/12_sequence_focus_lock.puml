@startuml Sequence_Focus_Lock
!theme plain
skinparam sequenceMessageAlign center
skinparam maxMessageSize 200
skinparam participant {
  BackgroundColor #E8F5E9
}

title Sequence Diagram: Contest Focus Lock & Auto-Ban (BKDNOJ moi)

actor "User\n(Thi sinh)" as U
participant "Browser\n(JavaScript)" as B
participant "Django Site" as Site
database "MariaDB" as DB
actor "Contest Admin" as Admin

== 1. Admin bat Focus Lock ==
Admin -> Site : Edit Contest\nenable_focus_lock = True
Site -> DB : UPDATE Contest\nenable_focus_lock=True

== 2. User tham gia contest ==
U -> Site : POST /contest/<key>/join
Site -> DB : SELECT Contest\nWHERE enable_focus_lock=True
Site --> B : Trang contest\nvoi Focus Lock enabled

== 3. Browser bat che do focus ==
B -> B : An navbar
B -> B : Request fullscreen\n(document.requestFullscreen)
B -> B : Dang ky event listeners:\n- visibilitychange\n- fullscreenchange\n- blur

== 4. Phat hien vi pham ==
alt User chuyen tab
  B -> B : Event: visibilitychange\ndocument.hidden = true
  B -> B : Tang violation count
  B -> Site : POST report violation
== 4. Phat hien vi pham (chi tinh khi LIVE) ==
alt User chuyen tab
  B -> B : Event: visibilitychange\ndocument.hidden = true
  B -> Site : POST /contest/report_focus_violation
  Site -> Site : Kiem tra participation.live\nAND contest.enable_focus_lock
  Site -> DB : UPDATE ContestParticipation\nfocus_violations = F('focus_violations') + 1
  B -> B : Hien thi canh bao:\n"Ban da roi khoi trang thi!"
else User thoat fullscreen (ESC)
  B -> B : Event: fullscreenchange\n!document.fullscreenElement
  B -> Site : POST /contest/report_focus_violation
  Site -> DB : UPDATE ContestParticipation\nfocus_violations = F('focus_violations') + 1
  B -> B : Yeu cau fullscreen lai
else User Alt+Tab / minimize
  B -> B : Event: blur
  B -> Site : POST /contest/report_focus_violation
  Site -> DB : UPDATE ContestParticipation\nfocus_violations = F('focus_violations') + 1
end

== 5. Admin xem vi pham ==
Admin -> Site : GET /contest/<key>/ranking/
Site -> DB : SELECT ContestParticipation\nORDER BY focus_violations DESC
Site --> Admin : Leaderboard voi cot\nfocus_violations

== 6. Disqualify thi sinh (neu can) ==
Admin -> Site : POST disqualify\nparticipation_id=<id>
Site -> DB : UPDATE ContestParticipation\nis_disqualified=True
Site -> Site : set_disqualified() -> check_ban()

== 7. Auto-ban (neu qua nguong) ==
Site -> DB : SELECT COUNT(*)\nContestParticipation\nWHERE user=user,\ncontest__is_organization_private=False,\nis_disqualified=True
DB --> Site : disqualifications_count

alt count >= BKDNOJ_MAX_DISQUALIFICATIONS_BEFORE_BANNING
  Site -> DB : user.ban_user(BKDNOJ_CONTEST_CHEATING_BAN_MESSAGE)\nis_active=False, ban_reason set
  note right of DB
    User bi ban
    khong the dang nhap
  end note
else count < nguong AND dang bi ban vi cheating
  Site -> DB : user.unban_user()\nis_active=True, ban_reason=NULL
  note right of DB
    Tu dong unban
    khi admin bo disqualify
  end note
end

note over Site
  Guard: chi auto-ban khi
  BKDNOJ_SHOULD_BAN_FOR_CHEATING_IN_CONTESTS=True
  va contest KHONG phai organization-private
end note

@enduml
