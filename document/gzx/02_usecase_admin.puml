@startuml UseCase_Admin
!theme plain
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor<<new>> #DDFFD6
  BorderColor<<new>> #2E8B57
}

left to right direction

actor "Problem Setter" as Setter
actor "Contest Admin" as ContAdmin
actor "Admin" as Admin
actor "Judge Server" as Judge

Setter <|-- ContAdmin
ContAdmin <|-- Admin

rectangle "HE THONG ALOJ - QUAN TRI" {

  package "Quan ly bai tap" {
    usecase "Tao/Sua/Xoa bai tap" as UC_ProbCRUD
    usecase "Upload test data (zip)" as UC_TestData
    usecase "Cau hinh time/memory limit" as UC_Limit
    usecase "Import tu Polygon" as UC_Polygon
    usecase "Tao de bai bang AI\n(AI Problem Creator)" as UC_AIProblem <<new>>
    usecase "Generate Testcase\nbang AI (GensolJob)" as UC_GenTest <<new>>
    usecase "Quan ly editorial" as UC_Editorial
  }

  package "Quan ly contest" {
    usecase "Tao/Sua contest" as UC_ContCRUD
    usecase "Cau hinh format\n(IOI/ICPC/AtCoder/ECOO/VNOJ)" as UC_Format
    usecase "Bat Focus Lock" as UC_FocusLock <<new>>
    usecase "Freeze scoreboard" as UC_Freeze
    usecase "MOSS (chong dao code)" as UC_MOSS
    usecase "Disqualify thi sinh" as UC_Disqual
    usecase "Rating contest" as UC_Rate
  }

  package "Quan ly he thong" {
    usecase "Quan ly user" as UC_UserMgmt
    usecase "Cau hinh judge" as UC_JudgeCfg
    usecase "Rejudge bai nop" as UC_Rejudge
    usecase "Tuy chinh AI Prompt" as UC_Prompt <<new>>
    usecase "Xem AI review logs" as UC_ReviewLog <<new>>
    usecase "Quan ly Organization" as UC_OrgMgmt
    usecase "Cau hinh he thong\n(MiscConfig)" as UC_Config
  }

  package "Judge Server" {
    usecase "Nhan packet tu Bridge" as UC_Recv
    usecase "Bien dich source code" as UC_Compile
    usecase "Chay test case\nvoi resource limits" as UC_Execute
    usecase "Tra ket qua\ntung test case" as UC_Return
    usecase "Chay Generator/Solution\n(GenSol)" as UC_GenSolExec <<new>>
  }
}

' --- Setter ---
Setter --> UC_ProbCRUD
Setter --> UC_TestData
Setter --> UC_Limit
Setter --> UC_Polygon
Setter --> UC_AIProblem
Setter --> UC_GenTest
Setter --> UC_Editorial

' --- Contest Admin ---
ContAdmin --> UC_ContCRUD
ContAdmin --> UC_Format
ContAdmin --> UC_FocusLock
ContAdmin --> UC_Freeze
ContAdmin --> UC_MOSS
ContAdmin --> UC_Disqual
ContAdmin --> UC_Rate

' --- Admin ---
Admin --> UC_UserMgmt
Admin --> UC_JudgeCfg
Admin --> UC_Rejudge
Admin --> UC_Prompt
Admin --> UC_ReviewLog
Admin --> UC_OrgMgmt
Admin --> UC_Config

' --- Judge Server ---
Judge --> UC_Recv
Judge --> UC_Compile
Judge --> UC_Execute
Judge --> UC_Return
Judge --> UC_GenSolExec

' --- Relationships ---
UC_FocusLock ..> UC_Disqual : <<extend>>
UC_Disqual ..> UC_UserMgmt : "auto-ban\n<<extend>>"
UC_GenTest ..> UC_GenSolExec : <<include>>
UC_AIProblem ..> UC_ProbCRUD : <<extend>>

@enduml
