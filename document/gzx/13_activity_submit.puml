@startuml Activity_Submit
!theme plain
skinparam activity {
  BackgroundColor<<new>> #DDFFD6
  BorderColor<<new>> #2E8B57
}

title Activity Diagram: Luong xu ly nop bai toan he thong

start

:User truy cap trang bai tap;
:Xem de bai, rang buoc, sample I/O;

if (enable_new_ide?) then (True)
  :Hien thi giao dien IDE\n(CodeMirror 6, 2 cot)] <<new>>
  :User viet code trong IDE;

  if (User bam Run?) then (Yes)
    :POST /problem/<code>/run] <<new>>
    :Tao RunSubmission (status=QU);
    :Gui run-request den Bridge;
    :Judge chay chi sample tests;
    :Tra ket qua qua WebSocket;
    :Hien thi ket qua tren IDE panel;
    note right: Khong luu vao Submission\nKhong anh huong diem
    :User xem ket qua Run;
  else (No - Bam Submit)
  endif
else (False)
  :Hien thi giao dien truyen thong;
  :User paste/upload code;
endif

:User bam Submit;
:POST /problem/<code>/submit;

:Validate:\n- Dang nhap?\n- Problem accessible?\n- Language hop le?\n- Source length?;

if (Validate OK?) then (Yes)
  :Tao Submission (status=QU);
  :Tao SubmissionSource;
  :Gui submission-request\nden Bridge (TCP :9998);

  :Bridge nhan va chuyen\nden Judge (TCP :9999);

  :Judge bien dich source code;

  if (Bien dich thanh cong?) then (Yes)
    :status = Processing;
    :status = Grading;

    repeat
      :Chay test case voi\nresource limits;
      :Tra ket qua test case;
      :Luu SubmissionTestCase;
      :Gui event qua WSEvent;
      :Browser cap nhat realtime;
    repeat while (Con test case?) is (Yes)
    -> Tat ca test da chay;

    :Tinh diem tong;
    :status = Done;
    :result = AC/WA/TLE/MLE/RTE/...;
    :Cap nhat Profile points;
    :Cap nhat Problem stats;

    if (Trong contest?) then (Yes)
      :Cap nhat ContestSubmission;
      :Cap nhat ContestParticipation score;
      :Cap nhat Leaderboard;
    else (No)
    endif

  else (No - Compile Error)
    :status = CE;
    :Luu error log;
  endif

  :Gui final event qua WSEvent;
  :Browser hien thi ket qua cuoi cung;

else (No)
  :Hien thi loi validation;
endif

stop

@enduml
